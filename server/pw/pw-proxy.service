[Unit]
Description=PhantomWatch resolve+proxy
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/pw
EnvironmentFile=/etc/pw.env
ExecStart=/usr/bin/node /opt/pw/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
