<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Every provider, API and media host is https; only the loopback updater speaks
         cleartext. An http media host (or a seedbox URL, once torrents are re-enabled)
         has to be added here, or the request fails closed. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
